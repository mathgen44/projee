{
  "name": "projee",
  "productName": "Projee",
  "version": "0.1.0",
  "description": "Lecteur vidéo de spectacle : conduite, GO, noir garanti avant et après chaque lecture, choix de la sortie vidéo et de la sortie son.",
  "main": "src/main/main.js",
  "author": "Hervé Sevellec",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.projee.app",
    "productName": "Projee",
    "icon": "src/assets/icon.png",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "projee",
        "name": "Projet Projee",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.video"
    }
  }
}
